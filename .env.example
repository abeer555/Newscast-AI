# =============================================================================
# NEWSCAST AI - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider API Keys (Required for Intelligence & Scriptwriting)
# -----------------------------------------------------------------------------

# Google Gemini (Primary frontier model for dossiers, scripts, evaluation)
GEMINI_API_KEY="AIzaSy_your_key_here"

# NVIDIA NIM (Fallback frontier model - Nemotron-3 Ultra 550B)
NVIDIA_api="nvapi-your_key_here"

# Groq API key (Fast inference, Llama-3.3-70B, TTS fallback)
GROQ_API_KEY="gsk_your_key_here"

# IMPORTANT (one-time, in the Groq console):
# The Orpheus TTS voice models require org-admin terms acceptance before first use.
# Visit https://console.groq.com/playground?model=canopylabs/orpheus-v1-english, accept the
# terms for canopylabs/orpheus-v1-english (and canopylabs/orpheus-arabic-saudi for Arabic),
# then press "Synthesize audio" on any episode — no restart needed.

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Custom database path (for production with persistent storage)
# Leave unset for local development (uses ./data/newscast.db)
# For production, point to a persistent volume: /mnt/data/newscast.db
# DB_PATH="/mnt/data/newscast.db"

# Seed demo data on empty database (default: false in production)
# SEED_DEMO="false"

# -----------------------------------------------------------------------------
# Local AI Services (Optional)
# -----------------------------------------------------------------------------

# Kokoro TTS Server (Local neural voice synthesis)
KOKORO_URL="http://127.0.0.1:8880"

# ComfyUI (Local image generation for video production)
COMFYUI_URL="http://127.0.0.1:8188"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Server port
PORT=3150

# Node environment
# NODE_ENV="production"
