# Groq API key — server-side only, never exposed to the client.
GROQ_API_KEY="gsk_your_key_here"

# IMPORTANT (one-time, in the Groq console):
# The Orpheus TTS voice models require org-admin terms acceptance before first use.
# Visit https://console.groq.com/playground?model=canopylabs/orpheus-v1-english , accept the
# terms for canopylabs/orpheus-v1-english (and canopylabs/orpheus-arabic-saudi for Arabic),
# then press "Synthesize audio" on any episode — no restart needed.
